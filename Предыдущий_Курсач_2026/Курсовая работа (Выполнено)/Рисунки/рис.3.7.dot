digraph "рис.3.7" {
  rankdir=LR;
  graph [dpi=240, bgcolor="white", pad="0.25", margin="0.05", nodesep="0.55", ranksep="0.8", splines=true];
  node [shape=box, style="rounded,filled", penwidth=1.5, margin="0.18,0.12", fontname="Arial", fontsize=13, color="#274C77", fillcolor="#EAF3FF"];
  edge [fontname="Arial", fontsize=11, color="#506B88", penwidth=1.3, arrowsize=0.9];
  query [label="Запрос пользователя"];
  filters [label="applied_filters\nrole_keywords", fillcolor="#FFF9DB", color="#8D6E00"];
  qvec [label="Вектор запроса\nencode_texts([query])"];
  sim [label="similarity_search()\ncosine_distance в pgvector", fillcolor="#FFF4E6", color="#BC6C25"];
  boost [label="_rank_with_domain_boost()\nкоррекция ранга\n(DOMAIN_BOOST_STEP)", fillcolor="#F9ECFF", color="#7B2CBF"];
  top5 [label="Top-5 вакансий\nполные поля +\ncosine_distance", fillcolor="#E8FFF1", color="#2D6A4F"];
