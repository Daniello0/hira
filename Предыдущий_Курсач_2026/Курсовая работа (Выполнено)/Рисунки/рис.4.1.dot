digraph "рис.4.1" {
  rankdir=TB;
  graph [dpi=240, bgcolor="white", pad="0.25", margin="0.05", nodesep="0.45", ranksep="0.7", splines=true];
  node [shape=box, style="rounded,filled", penwidth=1.5, margin="0.18,0.12", fontname="Arial", fontsize=13, color="#274C77", fillcolor="#EAF3FF"];
  edge [fontname="Arial", fontsize=11, color="#506B88", penwidth=1.3, arrowsize=0.9];
  start [label="", shape=circle, width=0.28, height=0.28, fixedsize=true, fillcolor="#274C77", color="#274C77"];
  user_query [label="Пользователь вводит\nтекстовый запрос", fillcolor="#E8FFF1", color="#2D6A4F"];
  normalize [label="user_search()\ntrim + проверка пустого запроса", fillcolor="#FFF4E6", color="#BC6C25"];
  empty_check [label="Запрос пустой?", shape=diamond, fillcolor="#FFF3BF", color="#8D6E00"];
  empty_result [label="Вернуть пустой\nUserSearchResult", fillcolor="#FFE8E8", color="#A61E4D"];
  llm_extract [label="Groq: извлечение фильтров\nget_vacancy_filters_from_text_async()\n(json_schema strict + allowed_values из БД)", fillcolor="#F9ECFF", color="#7B2CBF"];
  llm_validate [label="Проверка ответа\n_validate_llm_payload()", fillcolor="#FFF4E6", color="#BC6C25"];
  llm_ok [label="Ответ валиден?", shape=diamond, fillcolor="#FFF3BF", color="#8D6E00"];
  llm_error [label="RuntimeError:\nошибка валидации ответа LLM", fillcolor="#FFE8E8", color="#A61E4D"];
  normalize_filters [label="Нормализация\nrole_keywords и weighted filters\n(_normalize_role_keywords,\n_normalize_weighted_filters)", fillcolor="#FFF9DB", color="#8D6E00"];
  value_counts [label="Подсчёт частот значений\nbuild_vacancy_filter_value_counts()", fillcolor="#FFF9DB", color="#8D6E00"];
  relax_filters [label="Релаксация фильтров\n_relax_filters()", fillcolor="#FFF4E6", color="#BC6C25"];
  enough_candidates [label="Кандидатов\nдостаточно?", shape=diamond, fillcolor="#FFF3BF", color="#8D6E00"];
  drop_order [label="Порядок снятия по весу\nPROTECTED_RELAX_FILTER_KEYS\n(experience, employment)", fillcolor="#fce4ec", color="#880e4f"];
  drop_one [label="Снять одно поле\nобновить dropped_filters\nи relax_steps", fillcolor="#fce4ec", color="#880e4f"];
  recount [label="Повторно подсчитать\ncandidate_count\n(_count_filtered_candidates)", fillcolor="#FFF9DB", color="#8D6E00"];
  vector_search [label="Векторный поиск\nsimilarity_search()\nPostgreSQL + pgvector", fillcolor="#FFF4E6", color="#BC6C25"];
  boost [label="Domain boost\n_rank_with_domain_boost()\n(DOMAIN_BOOST_STEP)", fillcolor="#F9ECFF", color="#7B2CBF"];
  response [label="Итоговый UserSearchResult\n(filters + top-5 вакансий)", fillcolor="#E8FFF1", color="#2D6A4F"];
  end [label="", shape=doublecircle, width=0.36, height=0.36, fixedsize=true, fillcolor="#274C77", color="#274C77"];
  start -> user_query;
  user_query -> normalize;
  normalize -> empty_check;
  empty_check -> empty_result [label="да"];
  empty_result -> end;
  empty_check -> llm_extract [label="нет"];
  llm_extract -> llm_validate;
  llm_validate -> llm_ok;
  llm_ok -> normalize_filters [label="да"];
  llm_ok -> llm_error [label="нет"];
  llm_error -> end;
  normalize_filters -> value_counts;
  value_counts -> relax_filters;
  relax_filters -> enough_candidates;
  enough_candidates -> vector_search [label="да"];
  enough_candidates -> drop_order [label="нет"];
  drop_order -> drop_one;
  drop_one -> recount;
  recount -> enough_candidates;
  vector_search -> boost;
  boost -> response;
  response -> end;
}
